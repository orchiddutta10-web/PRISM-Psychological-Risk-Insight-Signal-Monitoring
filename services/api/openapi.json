i/v1/ml/insight/{subject_id}\":{\"post\":{\"tags\":[\"ml-engine\"],\"summary\":\"Evaluate Subject\",\"description\":\"Run the full Phase 10 pipeline and return a PRISM Insight Score.\\n\\nPipeline:\\n  1. Build feature vector from DB tables\\n  2. Isolation Forest â anomaly score\\n  3. Per-modality deviation scores\\n  4. Rule-based fusion engine\\n  5. PRISM Insight Score with interpretation\\n\\nOptionally persists the result to risk_scores_v2 and alerts_v2.\",\"operationId\":\"evaluate_subject_api_v1_ml_insight__subject_id__post\",\"security\":[{\"OAuth2PasswordBearer\":[]}],\"parameters\":[{\"name\":\"subject_id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"title\":\"Subject Id\"}}],\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/EvaluateRequest\",\"default\":{\"persist\":true}}}}},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/InsightScoreResponse\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}},\"get\":{\"tags\":[\"ml-engine\"],\"summary\":\"Get Latest Insight\",\"description\":\"Retrieve the most recently persisted PRISM Insight Score from the database.\\nDoes NOT run the ML pipeline â reads from risk_scores_v2.\",\"operationId\":\"get_latest_insight_api_v1_ml_insight__subject_id__get\",\"security\":[{\"OAuth2PasswordBearer\":[]}],\"parameters\":[{\"name\":\"subject_id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"title\":\"Subject Id\"}}],\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/InsightScoreResponse\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/api/v1/ml/insight/{subject_id}/history\":{\"get\":{\"tags\":[\"ml-engine\"],\"summary\":\"Get Insight History\",\"description\":\"Retrieve historical PRISM Insight Scores for this subject.\",\"operationId\":\"get_insight_history_api_v1_ml_insight__subject_id__history_get\",\"security\":[{\"OAuth2PasswordBearer\":[]}],\"parameters\":[{\"name\":\"subject_id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"title\":\"Subject Id\"}},{\"name\":\"limit\",\"in\":\"query\",\"required\":false,\"schema\":{\"type\":\"integer\",\"default\":30,\"title\":\"Limit\"}}],\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/InsightHistoryResponse\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/api/v1/ml/insight/{subject_id}/explain\":{\"get\":{\"tags\":[\"ml-engine\"],\"summary\":\"Get Explanation\",\"description\":\"Phase 11 â Full XAI explanation for a subject\u0027s PRISM Insight Score.\\n\\nReturns ranked contributing factors with direction/magnitude/importance,\\nnatural language explanation, timeline, counterfactuals, and per-modality\\nconfidence breakdown. Supports three audience tiers via the `audience`\\nquery parameter: guardian, clinician, scientist.\\n\\nThe explanation is an additive extension â it reads from the existing\\nInsightResult and enriches it with explainability metadata. No ML\\nre-inference is triggered for the GET endpoint.\",\"operationId\":\"get_explanation_api_v1_ml_insight__subject_id__explain_get\",\"security\":[{\"OAuth2PasswordBearer\":[]}],\"parameters\":[{\"name\":\"subject_id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\",\"title\":\"Subject Id\"}},{\"name\":\"audience\",\"in\":\"query\",\"required\":false,\"schema\":{\"type\":\"string\",\"pattern\":\"^(guardian|clinician|scientist)$\",\"default\":\