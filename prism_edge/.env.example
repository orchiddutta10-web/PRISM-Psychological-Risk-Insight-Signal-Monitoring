# PRISM Edge Behaviour Node — Environment Configuration
# Copy this file to .env and fill in your values

# ── Camera ──────────────────────────────────────────────────────────
PRISM_CAMERA_ID=0
PRISM_CAMERA_WIDTH=640
PRISM_CAMERA_HEIGHT=480
PRISM_CAMERA_FPS=30
PRISM_CAMERA_RECONNECT_DELAY=2.0

# ── Audio ───────────────────────────────────────────────────────────
PRISM_AUDIO_SAMPLE_RATE=16000
PRISM_AUDIO_CHUNK_MS=2000
PRISM_AUDIO_DEVICE_INDEX=0

# ── PRISM API Server ────────────────────────────────────────────────
PRISM_API_BASE_URL=http://192.168.1.100:8000
PRISM_DEVICE_ID=prism-edge-rpi4b-001
PRISM_DEVICE_JWT=YOUR_DEVICE_JWT_HERE

# ── ESP32 Bridge ────────────────────────────────────────────────────
PRISM_ESP32_BRIDGE_PORT=8081
# Optional shared secret; if set, ESP32 must send Authorization: Bearer <token>
PRISM_ESP32_BRIDGE_TOKEN=YOUR_BRIDGE_TOKEN

# ── Logging ─────────────────────────────────────────────────────────
PRISM_LOG_LEVEL=INFO
PRISM_LOG_DIR=/var/log/prism-edge
PRISM_DATA_DIR=/var/lib/prism-edge
