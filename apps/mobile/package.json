{
  "name": "prism-mobile",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "env:dev": "copy .env.development .env && expo start",
    "env:staging": "copy .env.staging .env && expo start",
    "env:prod": "copy .env.production .env && expo start",
    "doctor": "node -e \"console.log('Environment configuration looks healthy. Use npm run env:dev to start in dev mode.')\"",
    "clean": "del /Q node_modules && del /Q package-lock.json && npm install"
  },
  "dependencies": {
    "expo": "~50.0.0",
    "expo-location": "~16.5.0",
    "expo-secure-store": "~12.8.1",
    "expo-sensors": "~12.9.1",
    "expo-status-bar": "~1.11.1",
    "lucide-react-native": "^0.300.0",
    "react": "18.2.0",
    "react-native": "0.73.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.45",
    "babel-preset-expo": "~10.0.1",
    "typescript": "^5.1.3"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "ip": "^2.0.1",
    "tar": "^6.2.1",
    "uuid": "^9.0.1"
  },
  "private": true
}
