# ─── PRISM Mobile – Environment Variables ────────────────────────────────
# Copy to .env and edit as needed.  See docs/NETWORK-SETUP.md for details.

# ─── API Connection ───────────────────────────────────────────────────────
# Protocol: http | https
EXPO_PUBLIC_API_PROTOCOL=http

# Host: localhost for Expo Go on same machine
#       10.0.2.2 for Android emulator ➜ host loopback
#       <LAN-IP>  for physical devices on same Wi-Fi
EXPO_PUBLIC_API_HOST=localhost

# Port the FastAPI backend listens on
EXPO_PUBLIC_API_PORT=8000

# ─── WebSocket ────────────────────────────────────────────────────────────
# Protocol: ws | wss  (mirrors API_PROTOCOL: http➜ws, https➜wss)
EXPO_PUBLIC_WS_PROTOCOL=ws

# ─── Feature Flags ────────────────────────────────────────────────────────
EXPO_PUBLIC_ENABLE_DEBUG=false
EXPO_PUBLIC_ENABLE_MOCKS=false
EXPO_PUBLIC_LOG_LEVEL=info
EXPO_PUBLIC_ENABLE_TELEMETRY=true
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_WEBSOCKET=true
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=true
EXPO_PUBLIC_ENABLE_VERBOSE_NETWORK_LOGS=false
